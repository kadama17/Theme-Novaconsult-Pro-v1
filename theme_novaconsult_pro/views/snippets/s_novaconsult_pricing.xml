<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<template id="s_novaconsult_pricing" name="NovaConsult — Pricing">
  <section class="th-nova section section--alt o_we_snippet o_colored_level" data-snippet="s_novaconsult_pricing" data-name="NovaConsult — Pricing">
    <div class="sv-container">
      <div class="sectionHead">
        <h2>Packages</h2>
        <p>Three plans with a “featured” option. Fully editable in Builder.</p>
      </div>

      <div class="pricing oe_structure o_we_snippet_area" data-name="Pricing — Plans">
        <div class="plan o_we_snippet" data-snippet="s_text_block" data-name="Plan — Starter">
          <div class="plan__head">
            <h3>Starter</h3>
            <p>For a fast, clean launch.</p>
          </div>
          <div class="plan__price">
            <span class="plan__amount">$490</span><span class="plan__period">/ project</span>
          </div>
          <ul class="list">
            <li>1 landing page</li>
            <li>Palette setup</li>
            <li>Basic SEO</li>
          </ul>
          <div class="mt-3">
            <a href="/contactus" class="btn btn--soft w-full">Choose Starter</a>
          </div>
        </div>

        <div class="plan plan--featured o_we_snippet" data-snippet="s_text_block" data-name="Plan — Pro (Featured)">
          <div class="plan__head">
            <h3>Pro</h3>
            <p>Best for lead generation.</p>
          </div>
          <div class="plan__price">
            <span class="plan__amount">$990</span><span class="plan__period">/ project</span>
          </div>
          <ul class="list">
            <li>Homepage + 4 pages</li>
            <li>4 custom snippets</li>
            <li>Conversion copy review</li>
          </ul>
          <div class="mt-3">
            <a href="/contactus" class="btn btn--primary w-full">Choose Pro</a>
          </div>
        </div>

        <div class="plan o_we_snippet" data-snippet="s_text_block" data-name="Plan — Scale">
          <div class="plan__head">
            <h3>Scale</h3>
            <p>For teams that want a full system.</p>
          </div>
          <div class="plan__price">
            <span class="plan__amount">$1,990</span><span class="plan__period">/ project</span>
          </div>
          <ul class="list">
            <li>10+ sections</li>
            <li>Design system</li>
            <li>Analytics setup</li>
          </ul>
          <div class="mt-3">
            <a href="/contactus" class="btn btn--soft w-full">Choose Scale</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</template>
</odoo>

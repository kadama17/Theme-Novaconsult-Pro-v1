<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="s_nova_hero_split" name="Nova — Hero Split">
    <section class="th-nova o_we_snippet o_colored_level  nova-hero-split py-6"
             data-snippet="s_nova_hero_split"
             data-name="Nova — Hero Split">

      <div class="container">

        <div class="row align-items-center g-5">

          <!-- LEFT CONTENT -->
          <div class="col-lg-6">
            <div class="o_we_snippet_area" data-name="Hero Content">

              <span class="nova-badge mb-3 d-inline-block">
                Performance Consulting
              </span>

              <h1 class="nova-h1 mb-3">
                Build systems that scale your business.
              </h1>

              <p class="nova-muted mb-4">
                Strategy, automation and execution inside Odoo —
                structured, measurable, scalable.
              </p>

              <div class="d-flex gap-3 flex-wrap">
                <a href="#contact" class="btn btn-light nova-btn-accent">
                  Start a Project
                </a>
                <a href="#services" class="btn btn-outline-light nova-btn-soft">
                  Explore Services
                </a>
              </div>

            </div>
          </div>

          <!-- RIGHT IMAGE -->
          <div class="col-lg-6">
            <div class="nova-hero-media nova-card p-4">
              <img src="/web/static/img/placeholder.png"
                   class="img-fluid"
                   alt="Hero Illustration"
                   loading="lazy"/>
            </div>
          </div>

        </div>

      </div>
    </section>
  </template>
</odoo>
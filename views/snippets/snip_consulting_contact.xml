<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="snip_consulting_contact" key="theme_novaconsult_pro.snip_consulting_contact" name="NovaConsult — Page Contact">
    <section class="th-nova o_consulting_dark o_we_snippet o_colored_level"
             data-snippet="s_text_block"
             data-name="NovaConsult — Page Contact">
<!-- HERO -->
                    <section class="o_we_snippet o_colored_level" data-snippet="s_text_block">
                        <div class="sv-container">
                            <div class="pageHero">
                                <div class="kicker">Contact</div>
                                <h1>Request a diagnostic.</h1>
                                <p class="lead">
                                    Answer a few questions and we’ll propose a clear first step:
                                    quick wins, roadmap, and KPIs.
                                </p>

                                <div class="infoGrid oe_structure o_we_snippet_area" data-name="Contact - Quick info">
                                    <div class="info o_we_snippet o_colored_level" data-snippet="s_text_block">
                                        <strong>Email</strong>
                                        <span>contact@novaconsult.com</span>
                                    </div>
                                    <div class="info o_we_snippet o_colored_level" data-snippet="s_text_block">
                                        <strong>Phone</strong>
                                        <span>+212 6 12 34 56 78</span>
                                    </div>
                                    <div class="info o_we_snippet o_colored_level" data-snippet="s_text_block">
                                        <strong>Location</strong>
                                        <span>Casablanca • Remote</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

  <!-- CTA + FORM (Odoo Native Website Form Compatible) -->
<section class="section cta o_we_snippet o_colored_level s_website_form"
         data-snippet="s_website_form"
         data-name="CTA + Contact Form"
         id="contact">

    <div class="sv-container">
        <div class="ctaGrid">

            <!-- LEFT CONTENT -->
            <div class="oe_structure o_we_snippet_area">
                <h2>Let’s clarify your priorities in 30 minutes.</h2>
                <p class="p">
                    Tell us your main objective and current constraints.
                    We’ll suggest a realistic plan and the best starting offer.
                </p>

                <div class="bullets">
                    <div class="bullet"><b>✓</b> KPI &amp; priorities</div>
                    <div class="bullet"><b>✓</b> Quick wins</div>
                    <div class="bullet"><b>✓</b> 30/60/90 roadmap</div>
                </div>
            </div>

            <!-- RIGHT FORM -->
            <div class="oe_structure o_we_snippet_area">

                <div class="formCard">

                    <form action="/website/form/"
                          method="post"
                          enctype="multipart/form-data"
                          class="o_mark_required s_website_form"
                          data-mark="*"
                          data-model_name="crm.lead"
                          data-success-mode="redirect"
                          data-success-page="/contactus-thank-you"
                          data-pre-fill="true">

                        <!-- CSRF -->
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>

                        <!-- Lead title -->
                        <input type="hidden" name="name"
                               value="Form Request"/>

                        <!-- Optional email notification -->
                        <input type="hidden"
                               class="s_website_form_input"
                               name="email_to"
                               value="kadama328@gmail.com"/>

                        <div class="s_website_form_rows row s_col_no_bgcolor">

                            <!-- NAME -->
                            <div class="mb-3 col-12 s_website_form_field s_website_form_required"
                                 data-type="char"
                                 data-name="Field">
                                <label class="s_website_form_label"
                                       style="width:200px"
                                       for="strategy_name">
                                    <span class="s_website_form_label_content">Name</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>

                                <input id="strategy_name"
                                       type="text"
                                       class="form-control s_website_form_input"
                                       name="contact_name"
                                       required="required"/>
                            </div>

                            <!-- EMAIL -->
                            <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                 data-type="email"
                                 data-name="Field">
                                <label class="s_website_form_label"
                                       style="width:200px"
                                       for="strategy_email">
                                    <span class="s_website_form_label_content">Email</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>

                                <input id="strategy_email"
                                       type="email"
                                       class="form-control s_website_form_input"
                                       name="email_from"
                                       required="required"/>
                            </div>

                          

                            <!-- MESSAGE -->
                            <div class="mb-3 col-12 s_website_form_field"
                                 data-type="text"
                                 data-name="Field">
                                <label class="s_website_form_label"
                                       style="width:200px"
                                       for="strategy_message">
                                    <span class="s_website_form_label_content">Message</span>
                                </label>

                                <textarea id="strategy_message"
                                          class="form-control s_website_form_input"
                                          name="description"
                                          rows="4"/>
                            </div>

                            <!-- SUBMIT -->
                            <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end">
                                <div style="width:200px"
                                     class="s_website_form_label"/>
                                <a href="#"
                                   role="button"
                                   class="btn btn-primary w-full s_website_form_send">
                                    Send
                                </a>
                                <span class="s_website_form_result"/>
                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>
</section>
    </section>
  </template>
</odoo>
